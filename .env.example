# AI Orchestration Environment Config Example
# Copy this file to .env and replace placeholders with actual values.
# Do NOT commit the .env file.

# Gateway Authentication
GATEWAY_AUTH_TOKEN=your-secure-gateway-token-here

# Cluster Internal mTLS/gRPC Authentication
CLUSTER_AUTH_TOKEN=your-secure-cluster-token-here
ENABLE_MTLS=true

# Redis Cache/State
REDIS_URL=redis://your-redis-server:6379/0

# Optional: Disable Decision Engine for Fallback Testing
# SHADOW_MODE=false
